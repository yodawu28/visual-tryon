# RunPod kiosk deployment template.
# Copy this file to .env on the RunPod pod and fill secrets before starting.

# Application
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8080
API_PROFILE=kiosk

# CORS
# Add your RunPod proxy URL after the pod is created, for example:
# https://<pod-id>-8080.proxy.runpod.net
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ollama analyzer
SEMANTIC_PARSER_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=vto-brain
OLLAMA_TIMEOUT=300
TRYON_ANALYZER_OLLAMA_MODEL=qwen2.5vl:7b-q4_K_M
TRYON_ANALYZER_TIMEOUT=300

# Replicate visual preview provider
REPLICATE_API_TOKEN=r8_replace_me
REPLICATE_TIMEOUT=120
REPLICATE_PREVIEW_MODEL=qwen/qwen-image-edit-2511
REPLICATE_PREVIEW_MODEL_VERSION=
REPLICATE_PREVIEW_INPUT_MAPPING=multi_image_edit
REPLICATE_PREVIEW_GO_FAST=true
REPLICATE_PREVIEW_MODEL_WARNING=

# Avatar generation is not part of the kiosk default flow.
AVATAR_GENERATOR_MODE=replicate
LOCAL_AVATAR_MODEL_ID=stabilityai/sdxl-turbo
LOCAL_AVATAR_TIMEOUT=1200
LOCAL_AVATAR_OUTPUT_DIR=/workspace/tryon-data/avatar_cache/local_outputs
LOCAL_AVATAR_COMMAND=

# Visual generation mode
IMAGE_GEN_MODE=replicate-preview

# InsightFace / MediaPipe support
INSIGHTFACE_MODEL_DIR=/workspace/tryon-models/insightface
FACE_DETECTION_THRESHOLD=0.5

# Persistent storage. Keep all mutable runtime data under /workspace.
TEMP_STORAGE_DIR=/workspace/tryon-data
MAX_UPLOAD_SIZE_MB=10
PLAYWRIGHT_PROFILE_DIR=/workspace/tryon-data/playwright/profile
EVAL_REPORT_DIR=/workspace/tryon-data/eval/reports

# Local job queue for single-pod MVP.
JOB_QUEUE_BACKEND=local
JOB_QUEUE_DIR=/workspace/tryon-data/jobs

# Optional local/Colab FASHN VTON eval command template.
FASHN_VTON_COMMAND=

# Memory management
ENABLE_MEMORY_CLEANUP=true
CLEANUP_INTERVAL_SECONDS=300
