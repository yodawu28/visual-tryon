# Application
ENVIRONMENT=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
# kiosk: only health + kiosk APIs are mounted and shown in Swagger
# full: all legacy/evaluation APIs are mounted for debugging
API_PROFILE=kiosk

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Semantic Parser
# ollama: local vto-brain model through Ollama
# openai: explicit manual fallback/eval provider
SEMANTIC_PARSER_PROVIDER=ollama

# OpenAI API (required only when SEMANTIC_PARSER_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# Ollama semantic parser (used when SEMANTIC_PARSER_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=vto-brain
OLLAMA_TIMEOUT=300

# Optional Gemini-like multimodal analyzer for avatar preview.
# Analyzer enriches garment intent/prompt only; it does not choose the generation provider.
# Must match an installed `ollama list` model tag.
TRYON_ANALYZER_OLLAMA_MODEL=qwen2.5vl:7b-q4_K_M
TRYON_ANALYZER_TIMEOUT=300

# Kiosk visual preview provider.
# disabled: production-safe default when visual preview is not needed
# local_leffa: self-hosted GPU Leffa preview for tops/upper-body garments
# replicate_qwen: benchmark/debug only; do not use for production kiosk runtime
KIOSK_VISUAL_PREVIEW_PROVIDER=disabled

# Local Leffa visual preview provider.
# Prepare these paths on a GPU server with `make runpod-install-leffa-deps`
# and `make runpod-leffa-import-check` before enabling local_leffa.
LOCAL_LEFFA_ROOT=./models/external/Leffa
LOCAL_LEFFA_REPO_URL=https://github.com/franciszzj/Leffa.git
LOCAL_LEFFA_MODEL_REPO_ID=franciszzj/Leffa
LOCAL_LEFFA_CHECKPOINT_DIR=./models/external/Leffa/ckpts
LOCAL_LEFFA_HF_HOME=
LOCAL_LEFFA_TORCH_HOME=
LOCAL_LEFFA_XDG_CACHE_HOME=
LOCAL_LEFFA_PYTHON=
LOCAL_LEFFA_NO_CLONE=true
LOCAL_LEFFA_SIZE=768x1024
LOCAL_LEFFA_DEVICE=cuda
LOCAL_LEFFA_DTYPE=float16
LOCAL_LEFFA_VT_MODEL_TYPE=viton_hd
LOCAL_LEFFA_STEPS=30
LOCAL_LEFFA_GUIDANCE_SCALE=2.5
LOCAL_LEFFA_SEED=42
LOCAL_LEFFA_TIMEOUT=1800

# Replicate API.
# Optional for avatar/debug/evaluation flows. Kiosk production should not depend
# on Replicate Qwen visual preview.
REPLICATE_API_TOKEN=r8_your_replicate_api_token_here
REPLICATE_TIMEOUT=120
REPLICATE_PREVIEW_MODEL=qwen/qwen-image-edit-2511
REPLICATE_PREVIEW_MODEL_VERSION=
# multi_image_edit: qwen/qwen-image-edit-2511 style input
# google_nano_banana: google/nano-banana style input
REPLICATE_PREVIEW_INPUT_MAPPING=multi_image_edit
REPLICATE_PREVIEW_GO_FAST=true
REPLICATE_PREVIEW_MODEL_WARNING=

# Avatar generation.
# replicate: generate synthetic avatar through Replicate FLUX schnell
# local_command: run a trusted local command on this machine, then cache the output
AVATAR_GENERATOR_MODE=replicate
LOCAL_AVATAR_MODEL_ID=stabilityai/sdxl-turbo
LOCAL_AVATAR_TIMEOUT=1200
LOCAL_AVATAR_OUTPUT_DIR=./data/avatar_cache/local_outputs
# Placeholders are shell-escaped by the app. Do not wrap them in extra quotes.
# Required output: command must write a PNG/JPEG image to {output_image}.
# Example:
# LOCAL_AVATAR_COMMAND=python scripts/local_avatar_generate.py --prompt {prompt} --output {output_image} --size 768x768 --model-id stabilityai/sdxl-turbo --device auto --steps 4 --guidance-scale 0.0 --seed 42 --compact-avatar-prompt
LOCAL_AVATAR_COMMAND=

# Image Generation Mode
# local: CatVTON on MacBook (currently broken - CUDA compatibility issues)
# remote: Replicate IDM-VTON for actual try-on
# qwen-fast: backward-compatible alias for Replicate preview with Qwen
# replicate-preview: configurable Replicate preview model for debug/evaluation only
IMAGE_GEN_MODE=remote

# Local Diffusion (for MacBook M-series)
# Using SD 2.1 inpainting as fallback (better MPS support)
CATVTON_MODEL_ID=sd2-community/stable-diffusion-2-inpainting
CATVTON_DEVICE=mps
CATVTON_ENABLE_ATTENTION_SLICING=true
CATVTON_ENABLE_VAE_SLICING=true
CATVTON_ENABLE_CPU_OFFLOAD=true

# InsightFace
INSIGHTFACE_MODEL_DIR=~/.insightface/models
FACE_DETECTION_THRESHOLD=0.5

# Storage
TEMP_STORAGE_DIR=./data
MAX_UPLOAD_SIZE_MB=10
PLAYWRIGHT_PROFILE_DIR=./data/playwright/profile
EVAL_REPORT_DIR=./data/eval/reports

# Job queue
# local is a JSON-backed single-node queue for development.
# Future backends can implement the same JobQueueBackend contract.
JOB_QUEUE_BACKEND=local
JOB_QUEUE_DIR=./data/jobs

# Local/Colab FASHN VTON eval command template (optional)
# Placeholders: {avatar_image}, {garment_image}, {output_image}, {category}, {prompt}, {size}
FASHN_VTON_COMMAND=

# Memory Management
ENABLE_MEMORY_CLEANUP=true
CLEANUP_INTERVAL_SECONDS=300
